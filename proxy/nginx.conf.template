client_max_body_size 50M;
resolver 127.0.0.11 valid=30s ipv6=off;

server {
    listen 80;
    server_name .${DOMAIN_NAME}; 

    # Redirect all HTTP requests to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name sci.${DOMAIN_NAME};

    ssl_certificate /etc/letsencrypt/live/sci.${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sci.${DOMAIN_NAME}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # --- Security Rules ---
    location ~* /latest/meta-data { deny all; return 403; }
    location ~ /\.(?!well-known)  { deny all; return 403; }
    location ~* \.(env|bak|config|sql|yaml|yml|json|lock)$ { deny all; return 403; }
    location ~* /(wp-admin|wp-login\.php|xmlrpc\.php) { deny all; return 444; }
    location ~* /(phpmyadmin|myadmin|pma|dbadmin) { deny all; return 403; }

    # --- App Routing ---
    location / {
        set $frontend_upstream ${FRONTEND_URL};
        proxy_pass http://$frontend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

