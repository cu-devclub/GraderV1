# Stage 1: Build the React application
FROM node:21-alpine AS build

# Set working directory
WORKDIR /app

# Copy package.json and package-lock.json
COPY src/package.json src/package-lock.json ./

# Install dependencies
RUN npm ci

# Copy the source code and .env file
COPY src/src ./src
COPY src/public ./public
COPY src/.env* ./

# Build arguments from compose (overrides .env if provided)
ARG REACT_APP_HOST
ARG REACT_APP_DEV
ENV REACT_APP_HOST=${REACT_APP_HOST}
ENV REACT_APP_DEV=${REACT_APP_DEV}

# Build the application
RUN npm run build

# Stage 2: Serve the React application with Nginx (HTTP-only static files)
FROM nginx:alpine

# Copy the build files from the build stage
COPY --from=build /app/build /usr/share/nginx/html

# Copy the static SPA Nginx configuration (port 80 only, no SSL)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose HTTP
EXPOSE 80

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]